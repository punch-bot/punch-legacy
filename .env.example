# Punch — copy to .env

# Required bot token. Enable Message Content Intent in Discord Developer Portal.
DISCORD_TOKEN=

# Shared secret: bot HTTP basic auth + sandbox supervisor/gateway (quote-safe in docker run)
# Legacy env name OPENCODE_* kept for compose compatibility — product is Pi.
# Generate: openssl rand -hex 24  — or any string; spaces are OK
OPENCODE_SERVER_PASSWORD=

# Default LLM for sandboxes (provider/model). Legacy env name; Pi (not a free bundled provider).
OPENCODE_MODEL=anthropic/claude-sonnet-4-5

# Optional: NVIDIA NIM provider key (enables /models NIM options, /apikey set nim <key>)
# NVIDIA_API_KEY=

PREFIX=!
OPENCODE_TIMEOUT=300

# Optional: speech-to-text for Discord voice memos.
# Recommended free path: Groq Whisper free tier (no card) — https://console.groq.com
# GROQ_API_KEY=
# Paid / other OpenAI-compatible STT:
# STT_API_KEY=
# OPENAI_API_KEY=
# Optional operator overrides (bot .env only — sandbox cannot change the endpoint):
# STT_BASE_URL=https://api.groq.com/openai/v1
# STT_MODEL=whisper-large-v3-turbo

# Stack identity (also set in docker-compose.yml environment)
PUNCH_STACK_NAME=punch
PUNCH_VNC_PORT_BASE=16080

# Optional: noVNC password for sandbox browser view (published on host 16080+ per sandbox)
VNC_PASSWORD=

# --- Spectrum / Photon (starts with the Discord bot when configured) ---
# Docs: https://docs.photon.codes/docs/spectrum-ts/getting-started
# Dashboard: https://app.photon.codes/
# Auto-starts on bot ready when SPECTRUM_PROJECT_ID + SPECTRUM_PROJECT_SECRET are set.
# Aliases: PROJECT_ID + PROJECT_SECRET. Force off: SPECTRUM_ENABLED=0
# SPECTRUM_ENABLED=1
# SPECTRUM_MODE=agent
# SPECTRUM_PROVIDERS=imessage
# SPECTRUM_PROJECT_ID=
# SPECTRUM_PROJECT_SECRET=
# Optional static allowlist (otherwise unknown numbers get a Discord /pair code):
# SPECTRUM_USER_MAP={"+15551234567":"123456789012345678"}
# Optional local fallback for the terminal provider only (never used for unmapped iMessage):
# SPECTRUM_DEFAULT_USER_ID=
# Local smoke without Photon cloud: SPECTRUM_MODE=echo SPECTRUM_PROVIDERS=terminal

# --- Legacy values not used by Pi ---
# COMPOSIO_API_KEY, TS_AUTHKEY, PUNCH_DISABLE_COMPOSIO, PUNCH_DISABLE_TAILSCALE
# HOST_MIN_AUTH / make-min-auth.mjs — legacy auth seed (not required for Pi)

# Deploy:
#   cd /punch
#   docker compose up --build -d
#   In Discord: /sandbox create <name> <your_discord_user_id>
#   /apikey set anthropic <key>
